APP_NAME=LiztoApi
APP_ENV=staging
APP_KEY=base64:stgXyZ1234567890abcdefghijklmnopqrstuvwxyz=
APP_DEBUG=false
APP_URL=https://staging-api.lizto.app

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=staging-postgres
DB_PORT=5432
DB_DATABASE=lizto_staging
DB_USERNAME=lizto_staging
DB_PASSWORD=SecureStagingPass2026!

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=staging-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

RATE_LIMIT_LOGIN=5,1
RATE_LIMIT_CATALOG=60,1
RATE_LIMIT_PROTECTED=100,1

KYC_FILESYSTEM_DISK=local
CORS_ALLOWED_ORIGINS=https://staging.lizto.app,https://staging-web.lizto.app,http://localhost:3000

# Sentry / Observability (Optional in Staging)
SENTRY_LARAVEL_DSN=
